rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin';
    }

    function isVendor() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role in ['vendor', 'admin'];
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Allow user creation, but restrict self-assigning 'admin'
      allow create: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role in ['customer', 'vendor']);
      // Allow user updates, but forbid self-promoting to 'admin'.
      // (Upgrading customer → vendor during registration is legitimate.)
      allow update: if (isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role in ['customer', 'vendor'])) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // PRODUCTS COLLECTION
    match /products/{productId} {
      allow read: if true;
      allow create: if isVendor() &&
        (request.resource.data.vendorId == request.auth.uid || isAdmin()) &&
        request.resource.data.name is string &&
        request.resource.data.price is number &&
        request.resource.data.price >= 0 &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0;
      allow update: if isAuthenticated() &&
        (resource.data.vendorId == request.auth.uid || isAdmin()) &&
        request.resource.data.vendorId == resource.data.vendorId &&
        (!('price' in request.resource.data) ||
          (request.resource.data.price is number && request.resource.data.price >= 0)) &&
        (!('stock' in request.resource.data) ||
          (request.resource.data.stock is number && request.resource.data.stock >= 0));
      allow delete: if isAuthenticated() &&
        (resource.data.vendorId == request.auth.uid || isAdmin());
    }

    // CATEGORIES COLLECTION
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // COUPONS COLLECTION
    match /coupons/{couponId} {
      allow read: if true;
      // Only admins create/edit/delete. Redemptions are counted server-side by
      // /api/create-order (Admin SDK bypasses these rules).
      allow write: if isAdmin();
    }

    // VENDORS COLLECTION
    match /vendors/{vendorId} {
      allow read: if true;
      // Vendors may self-register but must NOT be able to set trust or
      // financial fields (verification, commission, ranking, aggregates) and
      // may only self-register as `pending` — activation is an admin decision.
      allow create: if (isOwner(vendorId) &&
        (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
        (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) &&
        (!('commissionRate' in request.resource.data)) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'pending') &&
        (!('totalSales' in request.resource.data)) &&
        (!('totalRevenue' in request.resource.data)) &&
        (!('rating' in request.resource.data)) &&
        (!('totalProducts' in request.resource.data))) ||
        isAdmin();
      allow update: if (isOwner(vendorId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'verified', 'isVerified', 'commissionRate', 'status', 'rating',
          'reviewCount', 'totalSales', 'totalRevenue', 'totalProducts'
        ])) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // ORDERS COLLECTION
    // Orders are created exclusively by /api/create-order using the Admin SDK
    // (which bypasses these rules). Clients must never write orders directly:
    // that would let a browser forge prices, stock or payment state.
    // Status/stock/audit changes go through /api/order-status, which also
    // restores inventory on cancellation and appends a status history entry.
    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid ||
         resource.data.get('vendorIds', []).hasAny([request.auth.uid]) ||
         isAdmin());
      allow create: if false;
      // Admins may correct records (payment verification, manual fixes) from
      // the dashboard; vendors and customers must use the API.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // UTR CLAIMS — one doc per UTR hash. Written only by /api/create-order
    // (Admin SDK). Clients may read their own claims but never write them.
    match /utrs/{utrId} {
      allow read: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // REVIEWS COLLECTION
    // Reviews are written only by /api/reviews, which verifies the purchase and
    // recomputes the product's rating aggregates. A client can therefore never
    // fake a "Verified Purchase" badge or a rating.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // WISHLIST (Subcollection)
    match /users/{userId}/wishlist/{productId} {
      allow read, write: if isOwner(userId);
    }

    // PENDING PRODUCTS (Bulk import drafts)
    match /pending_products/{productId} {
      allow read: if isAuthenticated() && 
        (resource.data.vendorId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
        (request.resource.data.vendorId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && 
        (resource.data.vendorId == request.auth.uid || isAdmin());
    }

    // CARTS
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // NEWSLETTER SUBSCRIBERS
    // Sign-up is idempotent: if the email already exists the client can re-assert
    // `subscribed == true` without changing the email. Admin reads the list.
    match /newsletter_subscribers/{id} {
      allow create: if request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.email.matches('.*@.*') &&
        request.resource.data.email.matches('.*\\..*') &&
        request.resource.data.subscribed == true;
      allow update: if request.resource.data.email == resource.data.email &&
        request.resource.data.subscribed == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscribed', 'updatedAt']);
      allow read, delete: if isAdmin();
    }

    // Fallback deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}