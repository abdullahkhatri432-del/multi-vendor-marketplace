rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin';
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Allow user creation, but restrict self-assigning 'admin'
      allow create: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role in ['customer', 'vendor']);
      // Allow user updates, but forbid self-modifying the 'role' field
      allow update: if isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // PRODUCTS COLLECTION
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        (request.resource.data.vendorId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && 
        (resource.data.vendorId == request.auth.uid || isAdmin()) &&
        request.resource.data.vendorId == resource.data.vendorId;
      allow delete: if isAuthenticated() && 
        (resource.data.vendorId == request.auth.uid || isAdmin());
    }

    // CATEGORIES COLLECTION
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // COUPONS COLLECTION
    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Authenticated users may bump usedCount when applying a coupon
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'updatedAt']) &&
         request.resource.data.usedCount == resource.data.usedCount + 1)
      );
    }

    // VENDORS COLLECTION
    match /vendors/{vendorId} {
      allow read: if true;
      // Vendors may self-register but must NOT be able to set verified status.
      allow create: if isOwner(vendorId) &&
        (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
        (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) ||
        isAdmin();
      allow update: if isOwner(vendorId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'isVerified', 'commissionRate', 'status']) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // ORDERS COLLECTION
    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid ||
         resource.data.vendorIds.hasAny([request.auth.uid]) ||
         isAdmin());
      // Customers may create their own orders, but payment verification fields
      // are admin-only. paymentStatus on create is restricted so a client cannot
      // forge an already-verified / completed payment.
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.paymentStatus in ['pending', 'pending-verification', 'advance-paid', 'completed'] &&
        !('verifiedBy' in request.resource.data) &&
        !('verifiedAt' in request.resource.data) &&
        !('verifiedUtr' in request.resource.data) &&
        !('verifiedAmount' in request.resource.data);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.vendorIds.hasAny([request.auth.uid]) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerId', 'vendorId', 'total', 'items', 'createdAt', 'paymentStatus', 'paymentReference', 'paymentDetails']))
      );
    }

    // REVIEWS COLLECTION
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }

    // WISHLIST (Subcollection)
    match /users/{userId}/wishlist/{productId} {
      allow read, write: if isOwner(userId);
    }

    // PENDING PRODUCTS (Bulk import drafts)
    match /pending_products/{productId} {
      allow read: if isAuthenticated() && 
        (resource.data.vendorId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
        (request.resource.data.vendorId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && 
        (resource.data.vendorId == request.auth.uid || isAdmin());
    }

    // CARTS
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // NEWSLETTER SUBSCRIBERS
    match /newsletter_subscribers/{id} {
      allow create: if request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.email.matches('.*@.*') &&
        request.resource.data.email.matches('.*\\..*') &&
        request.resource.data.subscribed == true;
      allow read, update, delete: if isAdmin();
    }

    // Fallback deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}