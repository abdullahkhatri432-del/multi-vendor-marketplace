{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/import-product.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/bulk-import.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
