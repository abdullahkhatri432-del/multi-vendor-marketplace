# ---------------------------------------------------------------------------
# Client (Vite) — these values are embedded in the browser bundle.
# All are optional: src/config/firebase.js has working defaults for this project.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Show the built-in demo catalogue when Firestore has no products.
# Default: OFF. Only set to true for local demos — never in production.
VITE_ENABLE_DEMO_DATA=false

# Canonical public origin used for canonical URLs, Open Graph and the sitemap.
VITE_SITE_URL=https://speedersmania.vercel.app

# UPI details shown at checkout (must match UPI_ID on the server).
VITE_UPI_ID=8160587811@kotak811
VITE_UPI_PAYEE_NAME=Speedersmania

# Optional analytics overrides (GA4 is enabled in production by default).
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Server / API (Vercel functions and `npm run dev:api`). Never expose these
# to the browser. Set them in Vercel → Project → Settings → Environment Variables
# for production, and in a local .env for development.
# ---------------------------------------------------------------------------

# Firebase service account JSON (single line). Required by api/create-order,
# api/import-product and api/bulk-import.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}

# Canonical UPI id used to verify orders (defaults to 8160587811@kotak811).
UPI_ID=8160587811@kotak811

# Comma-separated browser origins allowed to call the API.
# Example: https://speedersmania.vercel.app,https://your-preview.vercel.app
# Leave empty to use localhost defaults in development and deny cross-origin
# requests in production.
ALLOWED_ORIGINS=

# Optional port for the local API server (defaults to 3001).
PORT=3001

# ---------------------------------------------------------------------------
# Operations (alerts, backups, daily health check). See docs/OPERATIONS.md.
# ---------------------------------------------------------------------------

# Shared secret Vercel sends as `Authorization: Bearer <secret>` to the cron
# endpoints (/api/backup, /api/cron-health). Generate with: openssl rand -hex 32
# Leave unset to disable both cron endpoints (they fail closed with 401).
CRON_SECRET=

# 32-byte key used to encrypt backups before they are uploaded. Accepts a
# 64-char hex string (openssl rand -hex 32) or any passphrase (scrypt-stretched).
# Backups are refused when this is missing — they contain customer PII.
BACKUP_ENCRYPTION_KEY=

# Vercel Blob store used for backups. Created automatically when you add a Blob
# store to the project; `vercel env pull` writes it for you.
BLOB_READ_WRITE_TOKEN=

# Alert webhook for 5xx errors, failed backups and CSP violations.
# Slack: https://hooks.slack.com/services/...  Discord: https://discord.com/api/webhooks/...
# Anything else receives a generic JSON body (works with Zapier/Make email relays).
ALERT_WEBHOOK_URL=

# Public origin the daily health check probes (defaults to VITE_SITE_URL).
SITE_URL=

