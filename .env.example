# Frontend - Vite environment variables (must start with VITE_)
VITE_API_ENDPOINT=http://localhost:3001/api/import-product

# Backend - Node.js API Server (api-server.js) - for local development
# Get your service account JSON from Firebase Console > Project Settings > Service Accounts
# Then run: node -e "console.log(JSON.stringify(require('./serviceAccountKey.json')))" 
# to get a minified JSON string you can paste here
FIREBASE_SERVICE_ACCOUNT=

# Or set individual fields for easier setup:
# FIREBASE_ADMIN_PROJECT_ID=myprojects-ebc25
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Production - When deployed, the API endpoint will be proxied or use the actual URL
# VITE_API_ENDPOINT=https://your-domain.com/api/import-product