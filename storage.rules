rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /product-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 5 * 1024 * 1024 && // max 5 MB
        request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif|svg\\+xml)');
    }

    // Payment proof screenshots uploaded by customers during manual-payment checkout.
    // Only the owner may upload; any authenticated user can read (so admins can view
    // proofs linked from order documents). Files are images only, max 5 MB.
    match /payment-proofs/{userId}/{orderId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|jpg|webp)');
    }
  }
}