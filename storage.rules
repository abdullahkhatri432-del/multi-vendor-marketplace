rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /product-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 5 * 1024 * 1024 && // max 5 MB
        request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif|svg\\+xml)');
    }
  }
}