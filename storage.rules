rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Public product imagery. Anyone may read (needed for storefront rendering);
    // writes require a signed-in user and must be real images under 5 MB.
    match /product-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif|svg\\+xml)');
    }

    // Payment-proof uploads were removed from checkout, so the only Storage
    // namespace that exists is product imagery. Anything else is denied below.

    // Deny anything not explicitly matched above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
